scripts/.venv/
__pycache__/
*.pyc
target/
eval/results/*.log
# scripts/build.sh's wasm-bindgen output (crates/lean/pkg/ is
# ignored the same way, via wasm-pack's own auto-written pkg/.gitignore -
# wasm-bindgen doesn't write one, so pkg-mt/ needs it here instead).
crates/lean/pkg-mt/

# Pages demo assets: lean's web build output, copied into web/lean/ for
# local serving and by .github/workflows/pages.yml for the published site.
# Not committed to main -- the workflow builds it from crates/lean/pkg* on
# every deploy, same as crates/lean/pkg-mt/ above.
web/lean/
